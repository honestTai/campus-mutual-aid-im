@startuml
actor "后台管理员用户" as admin
participant "校园App用户信息查询界面" as queryPage
database "系统记录" as systemRecords
participant "系统" as system

activate admin
admin -> queryPage: 进入校园App用户信息查询界面
activate queryPage

admin -> queryPage: 输入要查询的用户名称关键字
queryPage -> system: 后台管理员用户输入查询关键字请求
activate system

system -> systemRecords: 模糊查询用户列表
activate systemRecords
systemRecords --> system: 用户列表结果
deactivate systemRecords

admin -> queryPage: 选择某一用户
queryPage -> system: 后台管理员用户选择用户请求
activate system

system -> systemRecords: 获取用户数据统计信息
activate systemRecords
systemRecords --> system: 数据统计结果
deactivate systemRecords

deactivate admin
deactivate system
@enduml
